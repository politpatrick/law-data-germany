amt."}]}},"fussnoten":null}},{"@builddate":"20250909220001","@doknr":"BJNR114200010BJNE001601129","metadaten":{"jurabk":"BBankLV","enbez":"Anlage 2","titel":{"@format":"XML","#text":"(zu § 8 Abs 1)"}},"textdaten":{"text":{"@format":"XML","Content":{"P":{"noindex":{"kommentar":{"@typ":"Fundstelle","BR":[null,null],"#text":"(Fundstelle: BGBl. 2025 I Nr. 198, S. 4)"}}},"table":{"@colsep":"1","@frame":"all","@pgwide":"1","@tocentry":"%yes;","tgroup":{"@align":"left","@char":"","@charoff":"50","@cols":"3","colspec":[{"@colname":"c1","@colwidth":"10*"},{"@colname":"c2","@colwidth":"70*"},{"@colname":"c3","@colwidth":"80*"}],"thead":{"@valign":"bottom","row":{"@rowsep":"1","@valign":"middle","entry":[{"@VJ":"1"},{"@VJ":"1","@align":"center","BR":[null,null],"#text":"Laufbahnen nach der Anlage zu § 37 Absatz 2der Vorschriften über die Vorbildung und die Laufbahnender Beamten der Deutschen Bundesbank"},{"@VJ":"1","@align":"center","#text":"Entsprechende Laufbahnen"}]}},"tbody":{"@valign":"top","row":[{"entry":[{"@VJ":"1","@rowsep":"0","B":"1"},{"@VJ":"1","@rowsep":"0","B":"des höheren Dienstes"},{"@VJ":"1","@rowsep":"0"}]},{"entry":[{"@VJ":"1","@rowsep":"0","#text":"1.1"},{"@VJ":"1","@rowsep":"0","#text":"Wirtschaftsverwaltungsdienst"},{"@VJ":"1","@rowsep":"0","#text":"Höherer Bankdienst"}]},{"entry":[{"@VJ":"1","@rowsep":"0","#text":"1.2"},{"@VJ":"1","@rowsep":"0","#text":"Sprachendienst"},{"@VJ":"1","@rowsep":"0","#text":"Höherer sprach- und kulturwissenschaftlicher Dienst"}]},{"entry":[{"@VJ":"1","@rowsep":"0","#text":"1.3"},{"@VJ":"1","@rowsep":"0","#text":"Dienst als Statistikerin/Dienst als Statistiker"},{"@VJ":"1","@rowsep":"0","#text":"Höherer naturwissenschaftlicher Dienst"}]},{"entry":[{"@VJ":"1","@rowsep":"0","#text":"1.4"},{"@VJ":"1","@rowsep":"0","#text":"Dienst als Historikerin/Dienst als Historiker"},{"@VJ":"1","@rowsep":"0","#text":"Höherer sprach- und kulturwissenschaftlicher Dienst"}]},{"entry":[{"@VJ":"1","@rowsep":"0","#text":"1.5"},{"@VJ":"1","@rowsep":"0","#text":"Dienst als Informatikerin/Dienst als Informatiker"},{"@VJ":"1","@rowsep":"0","#text":"Höherer technischer Verwaltungsdienst"}]},{"entry":[{"@VJ":"1","@rowsep":"0","#text":"1.6"},{"@VJ":"1","@rowsep":"0","#text":"Dienst als Mathematikerin/Dienst als Mathematiker"},{"@VJ":"1","@rowsep":"0","#text":"Höherer naturwissenschaftlicher Dienst"}]},{"@rowsep":"1","entry":[{"@VJ":"1","#text":"1.7"},{"@VJ":"1","#text":"Technischer Dienst"},{"@VJ":"1","#text":"Höherer technischer Verwaltungsdienst"}]},{"entry":[{"@VJ":"1","@rowsep":"0","B":"2"},{"@VJ":"1","@rowsep":"0","B":"des gehobenen Dienstes"},{"@VJ":"1","@rowsep":"0"}]},{"entry":[{"@VJ":"1","@rowsep":"0","#text":"2.1"},{"@VJ":"1","@rowsep":"0","#text":"Wirtschaftsverwaltungsdienst"},{"@VJ":"1","@rowsep":"0","#text":"Gehobener Bankdienst"}]},{"entry":[{"@VJ":"1","@rowsep":"0","#text":"2.2"},{"@VJ":"1","@rowsep":"0","#text":"Technischer Dienst"},{"@VJ":"1","@rowsep":"0","#text":"Gehobener technischer Verwaltungsdienst"}]},{"@rowsep":"1","entry":[{"@VJ":"1","#text":"2.3"},{"@VJ":"1","#text":"Dienst als Informatikerin/Dienst als Informatiker"},{"@VJ":"1","#text":"Gehobener technischer Verwaltungsdienst"}]},{"entry":[{"@VJ":"1","@rowsep":"0","B":"3"},{"@VJ":"1","@rowsep":"0","B":"des mittleren Dienstes"},{"@VJ":"1","@rowsep":"0"}]},{"entry":[{"@VJ":"1","#text":"3.1"},{"@VJ":"1","#text":"Technischer Dienst"},{"@VJ":"1","#text":"Mittlerer technischer Verwaltungsdienst"}]}]}}}}},"fussnoten":null}}]}}